# Called after deployment. Map each runtime binary/catalog to its installed port, not to an
# inferred dependency list. Host tools may contain copies of DLLs: ignore tools/ and debug/.
file(GLOB lists "${installed}/vcpkg/info/*_${triplet}.list")
foreach(listfile IN LISTS lists)
    get_filename_component(index "${listfile}" NAME)
    string(REGEX MATCH "^[^_]+" port "${index}")
    file(STRINGS "${listfile}" files REGEX "^${triplet}/(bin/[^/]+\\.[dD][lL][lL]|([^/]+/)?plugins/platforms/qwindows\\.dll|translations/([^/]+/)?qtbase_ru\\.qm)$")
    foreach(path IN LISTS files)
        get_filename_component(name "${path}" NAME)
        string(TOLOWER "${name}" name)
        set("owner_${name}" "${port}")
    endforeach()
    string(REGEX REPLACE "^[^_]+_(.+)_${triplet}\\.list$" "\\1" "version_${port}" "${index}")
endforeach()
foreach(path IN LISTS crt)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    list(APPEND crt_names "${name}")
endforeach()
file(WRITE "${stage}/RUNTIME_INVENTORY.md" "# Runtime files in this build\n\nSee THIRD_PARTY_NOTICES.md and LICENSES/ports/. The SHA-256 hashes refer to the staged, deployable files.\n\n| File | Origin | SHA-256 |\n|---|---|---|\n")
file(GLOB_RECURSE runtime RELATIVE "${stage}" "${stage}/*.exe" "${stage}/*.dll" "${stage}/*.qm")
foreach(path IN LISTS runtime)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    set(port "${owner_${name}}")
    if(path MATCHES "^(bin/(PlaneDraft|pdconvert)\\.exe|plugins/(sample_line|frame_generator)\\.dll)$")
        set(origin "PlaneDraft (see LICENSE and LICENSES/MIT.txt)")
    elseif(path MATCHES "^tools/libredwg/(dwg2dxf|dxf2dwg)\\.exe$")
        # GPLv3 programs run as separate processes; the LGPL core never links or loads libredwg.
        set(origin "LibreDWG 0.14 (GPL-3.0-or-later, separate process)")
    elseif(name IN_LIST crt_names)
        set(origin "Microsoft Visual C++ Redistributable (VS 2022 x64)")
    elseif(port)
        set(origin "${port} ${version_${port}}")
        list(APPEND ports "${port}")
    else()
        message(FATAL_ERROR "Unattributed runtime file: ${path}")
    endif()
    file(SHA256 "${stage}/${path}" hash)
    file(APPEND "${stage}/RUNTIME_INVENTORY.md" "| `${path}` | ${origin} | `${hash}` |\n")
endforeach()
list(REMOVE_DUPLICATES ports)
foreach(port IN LISTS ports)
    file(COPY "${installed}/${triplet}/share/${port}/copyright"
              "${installed}/${triplet}/share/${port}/vcpkg.spdx.json"
         DESTINATION "${stage}/LICENSES/ports/${port}")
endforeach()
